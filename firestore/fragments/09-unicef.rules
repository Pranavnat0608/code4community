      function unicefProfilePath() {
        return /databases/$(database)/documents/unicefProfiles/$(request.auth.uid);
      }

      function isUnicefOfficer() {
        return isSiteAdmin() ||
          canEditClubHubPage('unicef') ||
          (isAuthenticated() &&
            exists(unicefProfilePath()) &&
            get(unicefProfilePath()).data.role in ['board', 'sponsor']);
      }

      function unicefMemberKeepsRole() {
        return request.resource.data.role == resource.data.role;
      }

      match /unicefSettings/{docId} {
        allow read: if true;
        allow create, update: if isUnicefOfficer() && docId == 'config';
        allow delete: if isSiteAdmin();
      }

      match /unicefProfiles/{uid} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                        request.auth.uid == uid &&
                        request.resource.data.role == 'member';
        allow update: if isAuthenticated() &&
                        ((request.auth.uid == uid && unicefMemberKeepsRole()) || isUnicefOfficer());
        allow delete: if isSiteAdmin();
      }

      match /unicefSubmissions/{id} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.status == 'pending' &&
                        request.resource.data.activityDescription is string &&
                        request.resource.data.activityDescription.size() >= 10 &&
                        request.resource.data.activityDescription.size() <= 1000 &&
                        request.resource.data.hoursCompleted is number &&
                        request.resource.data.hoursCompleted > 0 &&
                        request.resource.data.hoursCompleted <= 24 &&
                        request.resource.data.hourType in ['In Club', 'Out of Club', 'Summer Hours'];
        allow update: if isUnicefOfficer();
        allow delete: if isSiteAdmin();
      }

      match /unicefProofs/{id} {
        allow read: if isAuthenticated() &&
                      (resource.data.userId == request.auth.uid || isUnicefOfficer());
        allow create: if isAuthenticated() &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.imageData is string &&
                        request.resource.data.imageData.size() > 0 &&
                        request.resource.data.imageData.size() <= 700000;
        allow update, delete: if isUnicefOfficer();
      }

      match /unicefOpportunities/{id} {
        allow read: if true;
        allow create, update, delete: if isUnicefOfficer();
      }

      match /unicefAnnouncements/{id} {
        allow read: if true;
        allow create, delete: if isUnicefOfficer();
        allow update: if false;
      }
